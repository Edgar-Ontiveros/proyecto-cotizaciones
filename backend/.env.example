# Copia este archivo a `.env` y ajusta los valores. La aplicación NO arranca si
# falta alguna variable sin default (DATABASE_URL, JWT_SECRET).

# Conexión a PostgreSQL 17 (driver psycopg 3, sync). Obligatoria.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cotizaciones

# Secreto para firmar JWT (HS256). Obligatoria. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Minutos de vida del access token. Default: 30.
JWT_ACCESS_MINUTES=30

# Días de vida del refresh token (cookie httpOnly, con rotación). Default: 7.
JWT_REFRESH_DAYS=7

# Entorno de ejecución: dev | test | prod. Default: dev.
ENV=dev

# Nivel de logs (structlog JSON a stdout): DEBUG | INFO | WARNING | ERROR. Default: INFO.
LOG_LEVEL=INFO

# F16a: fuente de órdenes de compra de SAP (SOLO lectura). fake = sin VPN
# (OC 31000103 precargada); hana = HANA real (exige HANA_HOST/USER/PASSWORD).
FUENTE_OC=fake
# HANA_HOST=10.254.22.10   # desde dev por VPN; en producción 172.31.22.113 (HAProxy)
# HANA_PORT=30015
# HANA_USER=U_REPORTS2
# HANA_PASSWORD=
# HANA_SCHEMA=SBO_COMINOX
